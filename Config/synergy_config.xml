<?xml version="1.0" encoding="utf-8"?>
<!--
  角色羁绊配置

  作用：让"某几个角色凑在一起"时获得增益。每条 <Synergy> 就是一组羁绊：
  名单里的人同时在（默认还要同一条船），就给指定的人挂上增益状态。

  "谁在场"是靠装束自带的一个隐藏状态判断的（每 0.5 秒刷新一次，脱衣服 1 秒内就消失），
  所以换装、死亡、复活、中途加入都会自动跟上，一两秒内生效。
  各套装束对应的状态名见 Docs/角色羁绊系统-设计方案.md 的附录。

  别的模组也想加：在自己包里放一份同名文件 Config/synergy_config.xml 就行，会自动合并。
  合并规则：不同的 id 直接追加；同一个 id 谁在后面谁的整条生效；写 remove="true" 可以删掉已有的条目。

  <Synergy> 上能写的属性：
    id          必填，随便起个不重复的名字
    priority    越大越优先（默认 0）；一样大时先写的优先
    exclusive   互斥规则：none = 可以和其他羁绊一起生效（默认）；
                members = 和共用成员的羁绊互斥；all = 有它就排斥其他所有羁绊
                互相冲突时按 priority 高的保留，被挤掉的会撤掉它的增益
    scope       在哪算数：same_sub = 同一条船（默认）/ same_team = 同一队 / anywhere = 不限
    detect      算谁在场：crew = 玩家和玩家队的 AI 船员（默认）/ players = 只算玩家自己控制的角色
                / any = 谁都可以（包括中立、敌对角色）
    alive_only  默认 true（死了/昏迷不算在场）；写 false 则尸体也算
    mode        while_present = 人凑齐就生效、分开就取消（默认）；
                round_start = 只在开局 10 秒内凑齐才生效，之后一直持续到本局结束
    remove      写 true 就是删掉同 id 的那条，不用写子元素

  <Member> 子元素：名单，至少写 2 个人
    aff="装束身份状态名"   推荐这样写：同一个角色的几套装束共用一个身份状态
    item="装束物品id"      也可以直接按穿了哪件衣服判断（会漏掉 Plus / 特殊 / 头饰变体）

  <Grant> 子元素：要发的增益
    aff="增益状态名"（必填）
    to="member:1 / member:2 / members（默认，所有成员）/ crew（同船的全队）"
    strength="1"（默认 1，超过状态自己的上限会被截断）

  增益状态本身要带 duration（建议写 2.0，留够余量），人分开后也会被自动清掉。
  具体加多少技能/抗性/移速/血上限，写在状态定义里；这个文件只管"谁在场、给谁发什么"。
-->
<Synergies>

  <!-- ===== 示例：灵梦 + 魔理沙同船，各拿一份增益 =====
       用之前要先在内容模组的 Touhou_Character_Afflictions.xml 里把这两个增益状态定义好，
       否则加载时会跳过，并在日志里提示"增益状态没定义"。

  <Synergy id="reimu_marisa" scope="same_sub" alive_only="true" mode="while_present">
    <Member aff="Touhou_Reimu_Character_Effect"/>
    <Member aff="Touhou_Marisa_Character_Effect"/>
    <Grant aff="Touhou_Synergy_ReimuMarisa_Reimu"  to="member:1"/>
    <Grant aff="Touhou_Synergy_ReimuMarisa_Marisa" to="member:2"/>
  </Synergy>
  -->

  <!-- ===== 示例：三人羁绊，全船都吃增益 =====
  <Synergy id="satori_family" scope="same_sub">
    <Member aff="Touhou_Satori_Character_Effect"/>
    <Member aff="Touhou_Koishi_Character_Effect"/>
    <Member aff="Touhou_Kokoro_Character_Effect"/>
    <Grant aff="Touhou_Synergy_SatoriFamily_Team" to="crew"/>
  </Synergy>
  -->

  <!-- ===== 示例：按装束物品判定（同一角色只有这一套装束时可用）=====
  <Synergy id="meirin_punch" scope="same_sub">
    <Member item="Hong_Meirin_Plus"/>
    <Member aff="Touhou_Sakuya_Character_Effect"/>
    <Grant aff="Touhou_Synergy_MeirinPunch" to="member:1"/>
  </Synergy>
  -->

  <!--红魔馆全员-->
  <Synergy id="Touhou_Scarlet_Devil_Mansion_All_Members_Effect_Team" scope="same_team" detect="crew" alive_only="true" mode="while_present" >
    <Member aff="Touhou_Remilia_Character_Effect"/>
    <Member aff="Touhou_Flandre_Character_Effect"/>
    <Member aff="Touhou_Patchouli_Character_Effect"/>
    <Member aff="Touhou_Koakuma_Character_Effect"/>
    <Member aff="Touhou_Hong_Meirin_Character_Effect"/>
    <Grant aff="Touhou_Scarlet_Devil_Mansion_All_Members_Effect" to="members"/>
  </Synergy>

  <!--主角组-->
  <Synergy id="Touhou_Protagonist_Team_Effect_Team" scope="same_team" detect="players" alive_only="true" mode="round_start">
    <Member aff="Touhou_Reimu_Character_Effect"/>
    <Member aff="Touhou_Marisa_Character_Effect"/>
    <Grant aff="Touhou_Protagonist_Team_Effect" to="members"/>
  </Synergy>

  <!--古明地姐妹-->
  <Synergy id="Touhou_Komeiji_Sisters_Effect_Team" scope="same_team" detect="players" alive_only="true" mode="round_start">
    <Member aff="Touhou_Satori_Character_Effect"/>
    <Member aff="Touhou_Koishi_Character_Effect"/>
    <Grant aff="Touhou_Komeiji_Sisters_Effect" to="members"/>
  </Synergy>

  <!--最凶最恶姐妹-->
  <Synergy id="Touhou_The_Most_Ferocious_Wicked_Sisters_Effect_Team" scope="same_team" detect="players" alive_only="true" mode="round_start">
    <Member aff="Touhou_Shion_Character_Effect"/>
    <Member aff="Touhou_Jyoon_Character_Effect"/>
    <Grant aff="Touhou_The_Most_Ferocious_Wicked_Sisters_Effect" to="members"/>
  </Synergy>

</Synergies>
