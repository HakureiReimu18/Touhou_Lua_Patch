      <Body width="48" height="60" density="10" />
      <ItemContainer capacity="1" maxstacksize="128" hideitems="true" drawinventory="true" canbeselected="true"
                     containedstateindicatorstyle="bullet" ShowConditionInContainedStateIndicator="true">
        <!--新出的袋子是空的（容量上限见 Health）；存档值在构造之后写入，读档不受影响-->
        <StatusEffect type="OnSpawn" target="This" condition="-99999" disabledeltatime="true" />
        <Containable items="Touhou_Maple_Leaf_Revolver_Bullet" />
      </ItemContainer>
      <CustomInterface canbeselected="true" drawhudwhenequipped="true">
        <GuiFrame relativesize="0.08,0.1" anchor="BottomLeft" relativeoffset="0,0.31" style="ItemUI" />
        <Button text="uilabel.AmmoPouch_Load">
          <StatusEffect type="OnUse" target="This">
            <SpawnItem identifiers="Touhou_Ammo_Fill_Marker" spawnposition="ThisInventory" />
          </StatusEffect>
        </Button>
      </CustomInterface>
      <Holdable slots="Any,RightHand,LeftHand" msg="ItemMsgPickUpSelect" />
    </Item>

