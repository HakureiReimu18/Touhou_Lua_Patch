<?xml version="1.0" encoding="utf-8"?>
<Override>
  <Items>
    <!-- ============================================================
         武术武器制作说明
         ============================================================
         一件武术武器 = 普通近战武器结构（MeleeWeapon 数据）+ 动作组件（MartialArtsWeapon）
         + 可选的握持贴图层（MartialArtsWearable，纯贴图数据，见下）。

         操作（玩家）：右键按住 = 架势（拳架/持握），瞄准中左键 = 出招。
         连击：上一招结束 1 秒内再出招——双持自动换另一件武器的手，踢腿自动换脚。

         ── MartialArtsWeapon 全部可写属性 ─────────────────────────
         strike   : 招式类型，必填。
                    "punch" = 拳类（道具沿瞄准方向直线伸缩，手臂打直；
                              行走/水中可用）
                    "kick"  = 踢腿（原生攻击力驱动的正蹬；
                              必须站定（陆地上不动）才能踢，水中禁用）
         reach    : 攻击点前伸距离（米，相对瞄准方向）。拳类≈臂展（0.8~0.9 手
                    臂才打直），踢腿 1.0 上下。默认 punch 0.85 / kick 1.0。
         height   : 攻击点高度偏置（米，正值向上）。拳类一般 0，踢腿 -0.35
                    （腰胯高度）。默认 punch 0 / kick -0.35。
         duration : 动作时长（秒）。快拳 0.3~0.35，重拳 0.45，踢腿 0.4~0.5。
                    同时也是冷却下限：实际冷却 = max(本值+0.35, MeleeWeapon
                    的 reload) ÷ 攻速公式（见下）。
         force    : 仅 kick 用——蹬腿的肢体驱动力（每帧冲量系数，60次/秒，
                    个位数；默认 6）。太大会把人带跑，太小蹬不出去。
         torque   : 仅 kick 用——肢体转向扭矩。强烈建议保持 0（非 0 会注入
                    自旋）。组件默认 2.5，踢腿内部已强制按 0 处理。

         ── MeleeWeapon 侧调参（原版语义，直接生效）────────────────
         reload             : 攻速基数。实际冷却 = max(reload, duration+0.35)
                              ÷ (1+MeleeAttackSpeed) ÷ (1+品质攻速)
         <attack> 内：
           Affliction       : 伤害/异常（原版格式）。internaldamage=内伤主伤害，
                              stun=眩晕秒数，blunttrauma=钝伤。probability=概率
           targetimpulseworld : 击退冲量（X 自动乘朝向，Y 正=向上）
           targetimpulse    : 径向击退（从命中点向外）
           penetration      : 护甲穿透 0~1
           structuredamage  : 对船体/门伤害（踢门用）
           severlimbsprobability : 断肢概率（对怪物，给一点点很带感）
         伤害结算公式（自动执行）：(1+MeleeAttackMultiplier) × (1+品质威力)，
         词缀系统的近战词缀同样生效（就走这个入口）。

         ── 握持贴图（可选，穿戴层）────────────────────────────────
         物品末尾加一个 <MartialArtsWearable>（注意：不是 <Wearable>——
         原版 Wearable 组件挂在武器上会干扰出招，实测加入就出不了拳）。
         它是纯数据组件：内部用分离的 Wearable 实例复用原版 sprite 解析，
         与槽位/输入/装备系统零交互。里面的 <sprite>
         用原版穿戴贴图的完整格式——和做一件潜水服一模一样：
           <sprite name="..." texture="贴图路径" limb="LeftHand"
                   inheritlimbdepth="false" inheritscale="true" scale="0.5"
                   hidelimb="false" sourcerect="x,y,w,h" origin="0.5,0.5" />
         limb 决定贴图挂在哪根肢体上：LeftHand/RightHand（拳套/护手）、
         LeftLeg/RightLeg/LeftFoot/RightFoot（护腿）、Torso、Head 等，
         原版 LimbType 枚举都能用。sourcerect/origin/scale/depth 等属性
         与原版穿戴完全一致。手持时贴图自动挂到肢体上（跟随出招动作），
         放下自动摘除。
         ============================================================ -->

    <!--测试拳套：直拳（快而轻）-->
    <Item name="铁莲拳" identifier="Touhou_Iron_Lotus_Fist" tags="smallitem,weapon" subcategory="Touhou" category="Weapon" scale="0.2" impactsoundtag="impact_metal_light">
      <InventoryIcon texture="%ModDir%/Images/Touhou_Iron_Lotus_Fist.png" sourcerect="0,0,96,166" origin="0.5,0.5" />
      <Sprite texture="%ModDir%/Images/Touhou_Iron_Lotus_Fist.png" depth="0.4" sourcerect="0,0,96,166" />
      <Body width="24" height="16" density="5"/>
      <MeleeWeapon slots="Any,RightHand" holdpos="0,0" handle1="0,0" holdangle="0" reload="0.2" swing="false" msg="ItemMsgPickUpSelect">
        <attack targetimpulseworld="4,1">
          <Affliction identifier="blunttrauma" strength="9" />
          <Affliction identifier="internaldamage" strength="3"  />
          <Affliction identifier="stun" strength="0.2" probability="0.1" />
        </attack>
      </MeleeWeapon>
      <MartialArtsWeapon strike="punch" force="16" torque="2.5" duration="0.2" reach="1.6" height="0.1"/>
      <MartialArtsWearable>
        <sprite name="Touhou_Iron_Lotus_Fist" texture="%ModDir%/Images/Touhou_Iron_Lotus_Fist.png" limb="RightHand" inheritlimbdepth="true" inheritscale="false" scale="0.2"
                hidelimb="false" sourcerect="0,0,166,96" origin="0.5,0.5"/>
      </MartialArtsWearable>
    </Item>

