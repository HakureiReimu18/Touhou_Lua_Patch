<?xml version="1.0" encoding="utf-8"?>
<Override>
  <!--
    异常物品系统（当前在跑）：TH-01 会回来的货箱 + TH-02 比里面大的柜子 + TH-03「五十米」样本
    + TH-08 点名喇叭 + 铅封收容箱。
    一件物品一条规则；逻辑在 CSharp/Shared/AnomalousItems.cs，旧 Lua 已停载。
    休眠的 4 件在 _Archive/AnomalousItems_v1_全8件.xml，放出时搬回来配 Lua。

    机构命名（已定案，写档案/新物品时沿用）：
      - 中文：异常封锁局（日常简称就用这个）
      - 英文：S.E.A.L. — Sage Enclave for Anomalous Lockdown
      - 外勤分队：潜渊行动组（= 玩家；与主模组同名）
      - 档案卡抬头格式：【异常封锁局·证物登记 TH-XX】，落款"回收：潜渊行动组"
      - 档案全文与新增模板：Docs/异常封锁局档案/（README 为总目，SEAL-TH-XX_模板.md 开新档用）

    组件契约（C# 依赖，改动需同步）：
      - 收容物带 Touhou_Anomalous tag；收容箱带 Touhou_Containment tag，且带原版 artifactcontainer tag
        （原版异星遗物的效果触发条件是「容器无 artifactcontainer tag」，所以本箱挂这个 tag 即天然兼容，不用 Lua）
      - 持续音效挂 TouhouAnomaly 的 OnActive，每个实例各自循环；收容时组件停声
      - 收容判定：沿 ParentInventory 往上找，祖先带 Touhou_Containment 就全部失效
      - TH-08 走 RangedWeapon 出声与装填，C# 在成功 Use 后拿真实使用者

    贴图说明：水晶/喇叭用原版图调色（占位），收容箱用原版密封箱调色；正式美术后补。
  -->
  <Items>
    <!--普通容器遮不住；收容由组件检查整条父链-->
    <Item name="" identifier="Touhou_Anomaly_Restless_Light" tags="smallitem,alienartifact,Touhou_Anomalous"
          subcategory="Touhou" category="Alien" scale="0.35" maxstacksize="1" hideinmenus="true"
          cargocontaineridentifier="metalcrate" fireproof="true" impactsoundtag="impact_metal_light">
      <Sprite texture="Content/Items/Electricity/signalcomp.png" sourcerect="304,528,64,96" depth="0.55" origin="0.5,0.5"/>
      <InventoryIcon texture="Content/Items/Electricity/signalcomp.png" sourcerect="304,528,64,96" origin="0.5,0.5"/>
      <Body width="40" height="60" density="12"/>
      <Holdable slots="Any,RightHand,LeftHand" handle1="0,0" msg="ItemMsgPickUpSelect"/>
      <TouhouRestlessLight canbeselected="false" allowingameediting="false" updatewhenbroken="true"/>
    </Item>

    <!-- ========== 铅封收容箱：异常物品的"安全状态" ========== -->
    <Item name="重型封锁收容箱" identifier="Touhou_Containment_Crate" tags="crate,cabinet,container,Touhou_Containment,artifactcontainer,tsm_danger_box" subcategory="Touhou"
          category="Misc" scale="0.2" linkable="true" pickdistance="150" impactsoundtag="impact_metal_heavy" isshootable="true" GrabWhenSelected="true"
          HideConditionBar="true" showcontentsintooltip="true"
          description="【异常封锁局制式收容容器·丙型】内衬特殊隔离层与静音棉。把异常物品或异星遗物放进去——敲击声、心跳和喇叭声都会停下。对异星遗物同样有效，且不需要供电。至少对外人而言是这样。">
      <Price baseprice="800">
        <Price storeidentifier="merchantresearch" multiplier="1" sold="false" maxavailable="2" />
        <Price storeidentifier="merchantmilitary" multiplier="1" sold="false" maxavailable="1" />
        <Price storeidentifier="merchantoutpost" sold="false" />
        <Price storeidentifier="merchantcity" sold="false" />
        <Price storeidentifier="merchantmine" sold="false" />
      </Price>
      <Deconstruct time="10">
        <Item identifier="steel" amount="2" />
        <Item identifier="lead" amount="2" />
      </Deconstruct>
      <Fabricate suitablefabricators="fabricator" requiredtime="8">
        <RequiredSkill identifier="mechanical" level="25" />
        <RequiredItem identifier="steel" amount="3" />
        <RequiredItem identifier="lead" amount="3" />
        <RequiredItem identifier="Touhou_Bottle_Element" amount="2" />
        <RequiredItem identifier="plastic" amount="5" />
      </Fabricate>
      <Sprite texture="%ModDir%/Images/Touhou_Containment_Crate.png" sourcerect="0,0,424,600" depth="0.8" />
      <Body width="424" height="600" density="15" />
      <Holdable selectkey="Select" pickkey="Use" slots="RightHand+LeftHand" PickingTime="8.0" aimpos="65,-10" handle1="0,0" attachable="true" aimable="true">
        <RequiredItem items="screwdriver" type="Equipped" requireempty="true" IgnoreInEditor="false" />
        <StatusEffect type="OnActive" target="Character" SpeedMultiplier="0.5" setvalue="true" />
      </Holdable>
      <!-- 收容范围：本补丁收容物 + 原版异星遗物；内容物变化时点亮紫灯 -->
      <ItemContainer autofill="False" capacity="12" slotsperrow="4" maxstacksize="1" canbeselected="true" hideitems="true" >
        <Containable items="Touhou_Anomalous,alienartifact,tsm_danger_item,tsm_danger_bloack" />
      </ItemContainer>
      <LightComponent range="90" lightcolor="170,90,255,255" powerconsumption="0" IsOn="false" castshadows="false"
                      allowingameediting="false" canbeselected="false">
        <sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="0,0,1,1" origin="0.15,0" />
      </LightComponent>
      <TouhouAnomaly canbeselected="false" allowingameediting="false" updatewhenbroken="true" />
    </Item>

    <!-- ========== TH-01 会回来的货箱 ========== -->
    <Item name="「会回来的货箱」" identifier="Touhou_Anomaly_Returning_Box" tags="Touhou_Anomalous,crate" subcategory="Touhou"
          category="Misc" scale="0.5" linkable="true" pickdistance="150" impactsoundtag="impact_metal_heavy" maxstacksize="1"
          description="【异常封锁局·证物登记 TH-01｜流拍】来源：鸟船遗迹打捞队。外观：标准密封货箱，焊缝无工具开启痕迹，内部持续发出轻微敲击声。备注：本证物已被投放至渊洋。它上周回来了。我们不再记录去向。回收：潜渊行动组。">
      <Price baseprice="1" canbespecial="false">
        <Price storeidentifier="merchantresearch" multiplier="1" sold="false" maxavailable="1" />
        <Price storeidentifier="merchantoutpost" sold="false" />
        <Price storeidentifier="merchantcity" sold="false" />
        <Price storeidentifier="merchantmilitary" sold="false" />
        <Price storeidentifier="merchantmine" sold="false" />
      </Price>
      <Sprite texture="Content/Items/Containers/containers.png" depth="0.54" sourcerect="407,376,152,89" origin="0.5,0.5"
              color="115,105,120,255" />
      <InventoryIcon texture="Content/Items/Containers/containers.png" sourcerect="407,376,152,89" origin="0.5,0.5" />
      <Body width="150" height="75" density="40" />
      <Holdable slots="RightHand+LeftHand" holdpos="0,-80" handle1="-30,14" handle2="30,14" aimable="false" msg="ItemMsgPickUpSelect">
        <StatusEffect type="OnActive" target="Character" SpeedMultiplier="0.7" setvalue="true" />
      </Holdable>
      <!-- 沿用旧存档的回归次数 -->
      <MemoryComponent canbeselected="false" allowingameediting="false" />
      <TouhouAnomaly canbeselected="false" allowingameediting="false" updatewhenbroken="true">
        <Sound file="Content/Sounds/Impact/MetalImpactLight1.ogg" type="OnActive" range="300" volume="0.5" loop="true" />
      </TouhouAnomaly>
      <!-- 光与声音分开，避免藏在普通背包里时灯组件休眠把声音也停了 -->
      <LightComponent range="40" lightcolor="80,70,90,255" powerconsumption="0" IsOn="false" castshadows="false"
                      allowingameediting="false" canbeselected="false">
        <sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="0,0,1,1" origin="0.15,0" />
      </LightComponent>
    </Item>

    <!-- ========== TH-02 比里面大的柜子 ========== -->
    <Item name="「比里面大的柜子」" identifier="Touhou_Anomaly_Bigger_Cabinet" tags="Touhou_Anomalous" subcategory="Touhou"
          category="Misc" scale="0.28" maxstacksize="1"
          description="【异常封锁局·证物登记 TH-02｜流拍】外观：双门铁柜，外尺寸 0.9×1.8m。内容积测量记录：第 4 次评估申请被驳回。驳回理由：评估员拒绝再次打开柜门。备注：柜门从内侧反锁过三次。回收：潜渊行动组。">
      <Price baseprice="1" canbespecial="false">
        <Price storeidentifier="merchantresearch" multiplier="1" sold="false" maxavailable="1" />
        <Price storeidentifier="merchantoutpost" sold="false" />
        <Price storeidentifier="merchantcity" sold="false" />
        <Price storeidentifier="merchantmilitary" sold="false" />
        <Price storeidentifier="merchantmine" sold="false" />
      </Price>
      <Deconstruct time="10">
        <Item identifier="steel" />
      </Deconstruct>
      <Sprite texture="%ModDir:2941124988%/Images/General_Items/Touhou_Ingredient_Refrigerator.png" depth="0.55"
              sourcerect="0,0,200,360" origin="0.5,0.5" />
      <InventoryIcon texture="%ModDir:2941124988%/Images/General_Items/Touhou_Ingredient_Refrigerator.png"
                     sourcerect="0,0,200,360" origin="0.5,0.5" />
      <Body width="60" height="100" density="45" />
      <Holdable slots="RightHand+LeftHand" holdpos="0,-100" handle1="0,0" aimable="false" msg="ItemMsgPickUpSelect">
        <StatusEffect type="OnActive" target="Character" SpeedMultiplier="0.5" setvalue="true" />
      </Holdable>
      <!-- 15 格，比外形离谱地能装；只换直接内容物，装着收容物的包也不碰 -->
      <ItemContainer capacity="15" maxstacksize="1" canbeselected="true" hideitems="true" keepopenwhenequipped="true" movableframe="true" />
      <TouhouAnomaly canbeselected="false" allowingameediting="false" updatewhenbroken="true" />
    </Item>

    <!-- ========== TH-03「五十米」样本 ========== -->
    <Item name="「五十米」样本" identifier="Touhou_Anomaly_Repulse_Stone" tags="Touhou_Anomalous" subcategory="Touhou"
          category="Misc" scale="0.2" maxstacksize="1"
          description="【异常封锁局·证物登记 TH-03】来源：鸟船遗迹核心舱段外缘，采集距离 50.2m（再靠近一米都没有人愿意试）。效应：活体靠近者出现恶心、眩晕与战栗，越近越重；死者会被送出圈外——评估员备注：样本不收藏死者，样本认识死者。回收：潜渊行动组。">
      <Price baseprice="1" canbespecial="false">
        <Price storeidentifier="merchantresearch" multiplier="1" sold="false" maxavailable="1" />
        <Price storeidentifier="merchantoutpost" sold="false" />
        <Price storeidentifier="merchantcity" sold="false" />
        <Price storeidentifier="merchantmilitary" sold="false" />
        <Price storeidentifier="merchantmine" sold="false" />
      </Price>
      <Sprite texture="%ModDir:2941124988%/Images/Alchemical/Touhou_Magic_Crystal_Environment.png" depth="0.55"
              sourcerect="0,0,256,288" origin="0.5,0.5" color="150,140,170,255" />
      <InventoryIcon texture="%ModDir:2941124988%/Images/Alchemical/Touhou_Magic_Crystal_Environment.png"
                     sourcerect="0,0,256,288" origin="0.5,0.5" />
      <Body width="50" height="55" density="60" />
      <Holdable slots="RightHand+LeftHand" holdpos="0,-60" handle1="0,0" aimable="false" msg="ItemMsgPickUpSelect">
        <StatusEffect type="OnActive" target="Character" SpeedMultiplier="0.85" setvalue="true" />
      </Holdable>
      <TouhouAnomaly canbeselected="false" allowingameediting="false" updatewhenbroken="true">
        <Sound file="Content/Sounds/HeartbeatSystole1.ogg" type="OnActive" range="600" volume="1.6" loop="true" />
      </TouhouAnomaly>
      <!-- 心跳按实例循环，收容时直接停声 -->
      <LightComponent range="45" lightcolor="120,30,30,255" powerconsumption="0" IsOn="false" castshadows="false"
                      allowingameediting="false" canbeselected="false">
        <sprite texture="Content/Particles/ParticleAtlas.png" sourcerect="0,0,1,1" origin="0.15,0" />
      </LightComponent>
    </Item>

    <!-- ========== TH-08 喇叭圣母的呼唤 ========== -->
    <Item name="喇叭圣母的呼唤" identifier="Touhou_Anomaly_Laugh_Trumpet" tags="Touhou_Anomalous" subcategory="Touhou"
          category="Misc" scale="1" maxstacksize="1"
          description="【异常封锁局·证物登记 TH-08】来源：小丑教派集会现场。黄铜喇叭，吹不响——除了在某些时刻。吹响时，圣母会随机点名在场的一位，与吹响者交换位置。吹之前想清楚：你不知道会换到谁，也不知道谁会觉得你的位置不错。注：小丑教徒似乎不受影响。回收：潜渊行动组。">
      <Price baseprice="1" canbespecial="false">
        <Price storeidentifier="merchantresearch" multiplier="1" sold="false" maxavailable="1" />
        <Price storeidentifier="merchantoutpost" sold="false" />
        <Price storeidentifier="merchantcity" sold="false" />
        <Price storeidentifier="merchantmilitary" sold="false" />
        <Price storeidentifier="merchantmine" sold="false" />
      </Price>
      <Sprite texture="Content/Items/Misc/Misc.png" depth="0.55" sourcerect="101,45,53,22" origin="0.5,0.5"
              color="220,190,90,255" />
      <InventoryIcon texture="Content/Items/InventoryIconAtlas.png" sourcerect="769,385,64,64" origin="0.5,0.5" />
      <Body width="50" height="20" density="15" />
      <!-- 车喇叭同款：RangedWeapon 只为触发 OnUse 出声，无射弹；10 秒装填防换位 spam -->
      <RangedWeapon reload="10">
        <Sound file="Content/Items/Weapons/honk.ogg" type="OnUse" range="1200" volume="2.0" />
      </RangedWeapon>
      <Holdable slots="Any,RightHand,LeftHand" aimpos="100,0" handle1="-15,-3" aimable="true" msg="ItemMsgPickUpSelect">
      </Holdable>
      <!-- 声音大得离谱，AI 听得见 -->
      <aitarget soundrange="1200" fadeouttime="5" />
    </Item>

  </Items>
</Override>
