<?xml version="1.0" encoding="utf-8"?>
<!--
  HUD 进度条配置（状态条）

  作用：把某个"状态"显示成屏幕边上的一根竖条。正面、负面、中性的状态都能显示。
  条的位置、颜色、显示开关，玩家可以在「东方模组设置 → 进度条设置」里自己调。

  别的模组也想加：只要在自己包里放一个同名文件 Config/hud_bars.xml 就行，系统会自动读取
  所有已启用模组里的这份文件。同一个状态被重复登记时，先加载的那份生效（本模组的文件排前面）。

  每根条写一个 <Bar>：
    affliction    要显示的状态 id（必填）
    name          条上的名字。不写就自动用游戏里的中文名（没有本地化时显示 id），
                  也可以填一个文本标识符
    color         颜色，R,G,B（0-255）
    maxstrength   满格对应的数值（默认 100）
    enabled       默认显示还是隐藏（默认显示；玩家可以自己改）
    showwhenzero  true = 数值为 0 时也显示（默认不显示）
    requireaffliction  只在身上有列表里的状态之一时才显示（逗号分隔），
                       比如"穿上这套装束才显示"
    requirejob         只在职业是列表里的之一时才显示（逗号分隔）
                       两条都写时，要同时满足

  可选子元素：
    <State affliction="…" text="…" color="R,G,B"/>
      这个状态数值 ≥1 时，把条的标题和颜色换成这一套（例如红美铃换成当前姿态）
    <Extra affliction="…" format="…{0}…"/>
      这个状态数值 >0 时，在条下面加一行小字，{0} 会替换成当前数值

  多条同时显示时：沿着屏幕右边缘一字排开、居中对齐，条名在上、附加行在下，每条占固定宽度。

  玩家调好的缩放/颜色/开关保存在存档目录的 TouhouHudBarsConfig.txt 里（按状态 id 记录，
  对本模组和别的模组登记的条都一样有效）
-->
<HudBars>
  <!-- 红美铃的「气」：只在穿着这套装束时显示（requireaffliction 就是那个"穿着装束期间挂着"的状态）；
       名字和姿态文字都省略不写，游戏会自动取中文名 -->
  <Bar affliction="Hong_Meirin_Qi" color="140,230,140" maxstrength="100" enabled="true"
       requireaffliction="Touhou_Hong_Meirin_Character_Effect">
    <State affliction="Hong_Meirin_Stance_Charge" color="140,230,140"/>
    <State affliction="Hong_Meirin_Stance_Guard" color="120,180,255"/>
    <State affliction="Hong_Meirin_Stance_Allout" color="255,110,110"/>
    <Extra affliction="Hong_Meirin_Stance_CD" format="Text.Hong_Meirin_Cooldown"/>
  </Bar>
  <!-- 下面这些条都省略了 name：游戏会自动取中文名 -->
  <Bar affliction="Alice_Doll_Energy" color="200,160,255" maxstrength="100" enabled="true"/>
  <Bar affliction="Touhou_Blood_Clock_Time" color="220,60,60" maxstrength="100" enabled="true"/>
  <Bar affliction="Blood_Needs_Remilia" color="180,30,30" maxstrength="100" enabled="true"/>
  <Bar affliction="Touhou_Misfortune_Curse" color="68,194,0" maxstrength="100" enabled="true"/>
  <Bar affliction="Touhou_Iroha_Fatigue" color="107,63,160" maxstrength="100" enabled="true"/>
  <Bar affliction="EmaTalent_Witch_Transformation" color="255,140,170" maxstrength="100" enabled="true"/>
  <Bar affliction="HiroTalent_Witch_Transformation" color="255,50,50" maxstrength="100" enabled="true"/>
  <Bar affliction="SherryTalent_Witch_Transformation" color="60,100,220" maxstrength="100" enabled="true"/>
  <Bar affliction="Touhou_Yousei_Power" color="220,220,220" maxstrength="100" enabled="true" requirejob="yousei"/>
  <Bar affliction="Touhou_Cosmic_Princess_Kaguya_Character_Effect_Hungry" color="252,253,116" maxstrength="100" enabled="true"/>
  <Bar affliction="Touhou_Magic_Overload" color="255,255,0" maxstrength="100" enabled="true"/>
  <Bar affliction="Patchouli_Asthma" color="120,75,100" maxstrength="100" enabled="true"/>
  <Bar affliction="FlandreTalent4_Effect_CD" color="220,55,55" maxstrength="100" enabled="true"/>
  <Bar affliction="Touhou_Lunatic_Reisen_Effect" color="220,25,200" maxstrength="100" enabled="true"/>
  <!-- 示例（对应 affliction ）：
  <Bar affliction="Alice_Doll_Energy" name="人偶能量" color="200,160,255" maxstrength="100" enabled="true"/>
  <Bar affliction="Touhou_Blood_Clock_Time" name="血之时计" color="220,60,60" maxstrength="100" enabled="true"/>
  <Bar affliction="Remilia_Bloodlust" name="渴血" color="180,30,30" maxstrength="100" enabled="true"/>
  -->
</HudBars>
