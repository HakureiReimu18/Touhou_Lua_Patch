    <!-- 异常物品系统（CSharp/Shared/Anomalies/AnomalousItems.cs）：
         排斥不适维持 Slow 档位，精神症状与器官损伤由 C# 按最近样本距离累计。
         ⚠ 休眠：失笑（TH-08 已改为点名换位，不再用眩晕；要恢复感染笑方案时从 _Archive 旧脚本搬回）
    <Stun name="失笑" identifier="Touhou_Anomaly_Forced_Laugh" description="你止不住地笑，笑得弯下腰，笑得丢掉了手里的东西。" type="stun"
          limbspecific="false" indicatorlimb="Head" activationthreshold="0" showiconthreshold="0" maxstrength="12">
      <Effect minstrength="0" maxstrength="100" strengthchange="-1.0" />
      <icon texture="%ModDir:2941124988%/Images/Afflictions/Touhou_Never_Give_Up_Effect.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
    </Stun>
    -->
    <Slow name="排斥不适" identifier="Touhou_Anomaly_Repulse" description="六米内逐渐积累精神症状，三米内开始器官损伤，两米内明显加重。远离或收容只停止新增暴露，已有损伤仍需治疗。这里不许活人靠近，也不许死者留下。" type="slow"
          limbspecific="false" indicatorlimb="Torso" activationthreshold="1" showiconthreshold="1" maxstrength="100">
      <!-- 档位由领域统一维持，离圈或装箱归零，不能再边维持边自然衰减 -->
      <Effect minstrength="0" maxstrength="100" strengthchange="0" minspeedmultiplier="1" maxspeedmultiplier="0.45"
              minchromaticaberration="0" maxchromaticaberration="6" />
      <icon texture="%ModDir:2941124988%/Images/Afflictions/Touhou_Never_Give_Up_Effect.png" sourcerect="0,0,128,128" color="255,255,255,255" origin="0,0" />
    </Slow>
