    <!--测试护腿：正蹬腿-->
    <Item name="断流护腿" identifier="Touhou_Torrent_Cutting_Greaves" tags="smallitem,weapon" subcategory="Touhou" category="Weapon" scale="0.25" impactsoundtag="impact_metal_light">
      <Sprite texture="%ModDir%/Images/Touhou_Torrent_Cutting_Greaves.png" sourcerect="0,0,184,352" depth="0.55" origin="0.5,0.5"/>
      <InventoryIcon name="" texture="%ModDir%/Images/Touhou_Torrent_Cutting_Greaves.png" sourcerect="0,0,184,352" origin="0.5,0.5"/>
      <Body width="30" height="20" density="5"/>
      <MeleeWeapon slots="Any,RightHand,LeftHand" holdpos="0,0" handle1="0,0" holdangle="0" reload="0.9" swing="false" msg="ItemMsgPickUpSelect">
        <attack targetimpulseworld="12,4">
          <Affliction identifier="blunttrauma" strength="36" />
