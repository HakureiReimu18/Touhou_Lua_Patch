  </Affix>
  <Affix identifier="vampiric" tier="Epic" nameprefix="‖color:192,64,255,255‖吸血‖color:end‖‖color:255,255,255,255‖" applicable="weapon" damagemult="1.04" desc="伤害 +4%；命中附加 6 点流血并回复自身 0.5 点物理伤害（1 秒冷却）">
    <StatusEffect type="OnUse" target="UseTarget" interval="1">
      <Affliction identifier="bleeding" strength="6" dividebylimbcount="true" />
    </StatusEffect>
    <StatusEffect type="OnImpact" target="UseTarget" interval="1">
      <Affliction identifier="bleeding" strength="6" dividebylimbcount="true" />
    </StatusEffect>
    <StatusEffect type="OnUse" target="Character" interval="1">
      <ReduceAffliction type="damage" amount="0.5" />
    </StatusEffect>
    <StatusEffect type="OnImpact" target="Character" interval="1">
      <ReduceAffliction type="damage" amount="0.5" />
    </StatusEffect>
  </Affix>
  <!-- 护甲：受伤 -6%，眩晕 -0.2/s，流血 -0.1/s -->
  <Affix identifier="guardian" tier="Epic" nameprefix="‖color:192,64,255,255‖守护‖color:end‖‖color:255,255,255,255‖" applicable="armor" damagetakenmult="0.94" desc="受到的伤害 -6%；穿戴时眩晕 -0.2/秒、流血 -0.1/秒">
    <StatusEffect type="OnWearing" target="Character">
      <Affliction identifier="stun" strength="-0.2" />
      <Affliction identifier="bleeding" strength="-0.1" dividebylimbcount="true" />
    </StatusEffect>
  </Affix>
  <Affix identifier="masterwork" tier="Epic" nameprefix="‖color:192,64,255,255‖大师‖color:end‖‖color:255,255,255,255‖" applicable="weapon" damagemult="1.07" fireratemult="1.05" desc="伤害 +7%，射速 +5%" />

  <!-- === LEGENDARY (橙色 255,140,0) === -->
