  <Items>
    <!-- ============================================================
         羁绊护符（伤害共担系统）
         逻辑全部在 CSharp/Shared/Bond*.cs（服务端权威）：
           穿戴检测 = 任意装备槽内带 Bond_Charm 标签的物品（不限槽位）
           容器槽 0 = 公式核心（Bond_Core，决定承伤曲线函数族）
           容器槽 1 = 调制芯片（Bond_Chip，决定曲线参数档位）
         ============================================================ -->
    <Item name="绑定护符" identifier="Touhou_Bond_Charm" category="Equipment" subcategory="Touhou"
          tags="Bond_Charm,smallitem,Touhou_Wearable_Equipment,Touhou_Condition_Loss_Rate_0.1" Scale="0.25" impactsoundtag="impact_metal_light">
      <PreferredContainer primary="generalstore" secondary="merchantoutpost,merchantcity" />
      <Price baseprice="400" sold="true">
        <Price storeidentifier="merchantgeneral" multiplier="1.0" />
        <Price storeidentifier="merchantoutpost" multiplier="1.0" />
        <Price storeidentifier="merchantcity" multiplier="0.9" />
      </Price>
      <Deconstruct time="5">
        <Item identifier="plastic" />
      </Deconstruct>
      <Fabricate suitablefabricators="Magic_Altar" requiredtime="3" >
        <RequiredSkill identifier="Touhou_Magic" level="20"/>
        <RequiredItem identifier="Touhou_Plant_Extract" amount="2" />
        <RequiredItem identifier="plastic" amount="2" />
        <RequiredItem identifier="Touhou_Base_Metal" />
        <RequiredItem identifier="Magic_Material" amount="3" />
      </Fabricate>
      <InventoryIcon texture="%ModDir%/Images/Touhou_Bond_Charm.png" sourcerect="0,0,116,160" origin="0.5,0.5" />
      <Sprite texture="%ModDir%/Images/Touhou_Bond_Charm.png" depth="0.55" sourcerect="0,0,116,160" origin="0.5,0.5" />
      <Body width="116" height="116" density="10" />
      <WifiComponent range="65000.0" LinkToChat="true" MinChatMessageInterval="0.0" />
      <!-- 耳机槽/头饰槽皆可佩戴；Any 让其可被拿在手中与放入背包 -->
      <Wearable type="Wearable" slots="Headset,Any" msg="ItemMsgPickUpSelect" />
      <!-- 槽 0：公式核心；槽 1：调制芯片。白名单写死 identifier，防止塞入无关物品 -->
      <ItemContainer capacity="1" maxstacksize="1" hideitems="false" >
        <Containable items="Bond_Core" />
        <SubContainer capacity="1" maxstacksize="1">
          <Containable items="Bond_Chip" />
        </SubContainer>
      </ItemContainer>
    </Item>

