      <Body width="26" height="18" density="5"/>
      <MeleeWeapon slots="Any,RightHand,LeftHand" holdpos="0,0" handle1="0,0" holdangle="0" reload="0.15" swing="false" msg="ItemMsgPickUpSelect">
