<?xml version="1.0" encoding="utf-8"?>
<!--
  装束包的补充收录表

  作用：把别的模组里的装束加进本模组的三个「装束包」，不用改代码。

  每件装束写一行 <Item>，category 选它进哪个包：
    basic    = 装束包（普通装束）
    plus     = 装束包+（强化装束）
    headwear = 头饰包（头饰）

  identifier 就是物品 XML 里的物品 id，要和它写的一模一样；已经在主表里的装束，这里写了也会被忽略。
-->
<CostumePackExtras>
  <!-- 示例：
  <Item category="basic" identifier="SomeExpansionMod_NewOutfit" />
  <Item category="plus" identifier="SomeExpansionMod_NewOutfit_Plus" />
  <Item category="headwear" identifier="SomeExpansionMod_NewHat" />
  -->
</CostumePackExtras>
