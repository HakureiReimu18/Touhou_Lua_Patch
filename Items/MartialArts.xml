        <sprite name="ma_gauntlet_l" texture="Content/Items/Weapons/weapons.png" limb="LeftHand" inheritlimbdepth="false" inheritscale="true" scale="0.5" hidelimb="false" sourcerect="0,0,32,32" origin="0.5,0.5"/>
        <sprite name="ma_gauntlet_r" texture="Content/Items/Weapons/weapons.png" limb="RightHand" inheritlimbdepth="false" inheritscale="true" scale="0.5" hidelimb="false" sourcerect="0,0,32,32" origin="0.5,0.5"/>
      </MartialArtsWearable>
