  <Affix identifier="ragnarok" tier="Legendary" nameprefix="‖color:255,140,0,255‖诸神黄昏‖color:end‖‖color:255,255,255,255‖" applicable="weapon" damagemult="1.14" desc="伤害 +14%；每 3 秒一波：50% 概率 12 烧伤+12 流血，30% 概率 0.5 秒眩晕">
    <StatusEffect type="OnUse" target="UseTarget" interval="3">
      <Affliction identifier="burn" strength="12" probability="0.5" dividebylimbcount="true" />
      <Affliction identifier="bleeding" strength="12" probability="0.5" dividebylimbcount="true" />
      <Affliction identifier="stun" strength="0.5" probability="0.3" />
    </StatusEffect>
    <StatusEffect type="OnImpact" target="UseTarget" interval="3">
      <Affliction identifier="burn" strength="12" probability="0.5" dividebylimbcount="true" />
      <Affliction identifier="bleeding" strength="12" probability="0.5" dividebylimbcount="true" />
      <Affliction identifier="stun" strength="0.5" probability="0.3" />
    </StatusEffect>
  </Affix>
  <!-- 护甲：受伤 -8% + 低速再生（内脏损伤 -0.05/s ≈ 33 分钟回 100，不取代药物） -->
  <Affix identifier="immortal" tier="Legendary" nameprefix="‖color:255,140,0,255‖不朽‖color:end‖‖color:255,255,255,255‖" applicable="armor" damagetakenmult="0.92" desc="受到的伤害 -8%；穿戴时缓慢持续回复内脏损伤/流血/缺氧">
    <StatusEffect type="OnWearing" target="Character">
      <Affliction identifier="internaldamage" strength="-0.05" dividebylimbcount="true" />
      <Affliction identifier="bleeding" strength="-0.15" dividebylimbcount="true" />
      <Affliction identifier="stun" strength="-0.3" />
      <Affliction identifier="oxygenlow" strength="-0.5" />
    </StatusEffect>
  </Affix>
  <!-- 命中给予东方模组 debuff「梦消失」：每层受伤 +0.4%，自然衰减 -1.5/s，实战维持 5~15 层 -->
  <Affix identifier="abyssal" tier="Legendary" nameprefix="‖color:255,140,0,255‖深渊‖color:end‖‖color:255,255,255,255‖" applicable="weapon" damagemult="1.10" fireratemult="1.06" desc="伤害 +10%，射速 +6%；命中 50% 概率附加 10 层「梦消失」（每层受伤 +0.4%，4 秒冷却）">
    <StatusEffect type="OnUse" target="UseTarget" interval="4">
      <Affliction identifier="Touhou_Lost_Dream" strength="10" probability="0.5" />
    </StatusEffect>
    <StatusEffect type="OnImpact" target="UseTarget" interval="4">
      <Affliction identifier="Touhou_Lost_Dream" strength="10" probability="0.5" />
    </StatusEffect>
  </Affix>

  <!-- === SPECIAL (红色 255,64,64) === -->
  <Affix identifier="euphoria" tier="Special" nameprefix="‖color:255,64,64,255‖亢奋‖color:end‖‖color:255,255,255,255‖" applicable="medical" desc="使用后目标 45 秒内移速 +35%，持续恢复内脏损伤并止血，附加 10 醉酒与 5 精神病">
    <!-- 目标 45 秒移速 ×1.35（逐帧 setvalue，结束后自动恢复） -->
    <StatusEffect type="OnUse" target="UseTarget" duration="45" SpeedMultiplier="1.35" setvalue="true" disabledeltatime="true" />
    <!-- 45 秒持续恢复：内脏损伤 -0.3/s、流血 -0.15/s -->
    <StatusEffect type="OnUse" target="UseTarget" duration="45">
      <ReduceAffliction type="damage" strength="-0.3" />
      <ReduceAffliction type="bleeding" strength="-0.15" />
    </StatusEffect>
    <StatusEffect type="OnUse" target="UseTarget">
      <Affliction identifier="drunk" strength="10" />
      <Affliction identifier="psychosis" strength="5" />
    </StatusEffect>
    <!-- 健康界面用药走 OnSuccess，与捅人注射（OnUse）等效 -->
    <StatusEffect type="OnSuccess" target="UseTarget" duration="45" SpeedMultiplier="1.35" setvalue="true" disabledeltatime="true" />
    <StatusEffect type="OnSuccess" target="UseTarget" duration="45">
      <ReduceAffliction type="damage" strength="-0.3" />
      <ReduceAffliction type="bleeding" strength="-0.15" />
    </StatusEffect>
    <StatusEffect type="OnSuccess" target="UseTarget">
      <Affliction identifier="drunk" strength="10" />
      <Affliction identifier="psychosis" strength="5" />
    </StatusEffect>
  </Affix>
  <!-- 移速 ×1.3 + 受伤 -5% + 眩晕积累 -0.05/s：轻量化特种装备 -->
  <Affix identifier="weightless" tier="Special" nameprefix="‖color:255,64,64,255‖失重‖color:end‖‖color:255,255,255,255‖" applicable="armor,wearable" damagetakenmult="0.95" desc="穿戴时移速 +30%，受伤 -5%，眩晕积累 -0.05/s">
    <StatusEffect type="OnWearing" target="Character" SpeedMultiplier="1.3" setvalue="true" disabledeltatime="true" />
    <StatusEffect type="OnWearing" target="Character">
      <Affliction identifier="stun" strength="-0.05" />
    </StatusEffect>
  </Affix>
</ItemAffixes>
