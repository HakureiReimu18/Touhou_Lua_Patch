  </Affix>
  <Affix identifier="lightning" tier="Epic" nameprefix="‖color:192,64,255,255‖雷霆‖color:end‖‖color:255,255,255,255‖" applicable="weapon" desc="命中 50% 概率附加 0.3 秒眩晕与 30 点电击（4 秒冷却）">
    <StatusEffect type="OnUse" target="UseTarget" interval="4">
